<?xml version="1.0" encoding="UTF-8"?>
<query-profile id="documents" type="root">
    <field name="hits" overridable="false">8</field>
    <field name="maxHits" overridable="false">100</field>
    <field name="timeout" overridable="false">1.0</field>
    <field name="model.restrict" overridable="false">reference_document</field>
    <field name="ranking.profile" overridable="false">reference_hybrid</field>
    <field name="presentation.summary" overridable="false">reference_summary</field>
    <field name="type" overridable="false">weakAnd</field>
    <field name="yql" overridable="false"><![CDATA[
        select * from reference_document where
        namespace_id contains @namespace_id and
        scope_id contains @scope_id and
        lifecycle_status contains "active" and
        (({targetHits:100}nearestNeighbor(chunk_embeddings, query_embedding)) or userQuery())
    ]]></field>
</query-profile>
